{
  "name": "southlake-service",
  "version": "1.0.0",
  "description": "Southlake Insurance - User Management Backend Service",
  "author": "Southlake",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "dotenv -e .env.development -- nest start",
    "start:dev": "dotenv -e .env.development -- nest start --watch",
    "start:debug": "dotenv -e .env.development -- nest start --debug --watch",
    "start:prod": "dotenv -e .env.production -- node dist/main",
    "db:migrate": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:revert -d src/database/data-source.ts",
    "db:generate": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:generate -d src/database/data-source.ts",
    "db:create": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:create",
    "db:seed": "dotenv -e .env.development -- node scripts/db-seed.js",
    "db:reset": "dotenv -e .env.development -- node scripts/db-reset.js",
    "db:refresh": "npm run db:reset && npm run db:seed",
    "test:db:migrate": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:run -d src/database/data-source.ts",
    "test:db:migrate:revert": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:revert -d src/database/data-source.ts",
    "test:db:seed": "dotenv -e .env.test -- node scripts/db-seed.js",
    "test:db:reset": "dotenv -e .env.test -- node scripts/db-reset.js",
    "test:db:refresh": "npm run test:db:reset && npm run test:db:seed",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "dotenv -e .env.development -- jest",
    "test:watch": "dotenv -e .env.development -- jest --watch",
    "test:cov": "dotenv -e .env.development -- jest --coverage",
    "test:e2e": "dotenv -e .env.test -- jest --config test/jest-e2e.json --forceExit",
    "test:e2e:watch": "dotenv -e .env.test -- jest --config test/jest-e2e.json --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@angular/cli": "^22.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      ".*\\.module\\.ts$",
      "main\\.ts$"
    ]
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true
  }
}
