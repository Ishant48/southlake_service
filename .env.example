NODE_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=southlake_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=change_me_in_production
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Southlake Insurance <noreply@southlake.com>"
APP_URL=http://localhost:4200
SESSION_EXPIRY_HOURS=24
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Redis (required for Bull queues and rate limiting in production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Bull Board dashboard (basic auth)
BULL_BOARD_PATH=/admin/queues
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change_me_in_production
