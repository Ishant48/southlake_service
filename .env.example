NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=southlake_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Southlake Insurance <noreply@southlake.com>"

APP_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
SESSION_EXPIRY_HOURS=24
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Rate limiting (requests per TTL window)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Only needed for `npm run migrate:from-starlight` (one-time legacy data import)
STARLIGHT_DB_HOST=localhost
STARLIGHT_DB_PORT=5432
STARLIGHT_DB_NAME=starlight
STARLIGHT_DB_USER=postgres
STARLIGHT_DB_PASSWORD=
